{
  "manifest_version": 3,
  "name": "Snap2Text - Convert Images to Text",
  "version": "0.0.0.1",
  "description": "Convert images on webpages to text and more.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.ico",
    "180": "icon-180.png",
    "192": "icon-192.png",
    "512": "icon-512.png"
  },
  "background": { "service_worker": "background.bundle.js", "type": "module" },
  "action": {},
  "permissions": ["scripting", "activeTab", "storage"]
}
